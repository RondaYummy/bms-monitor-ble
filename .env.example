# Telegram notifications for deploy.sh (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN="<your-bot-token>"
TELEGRAM_CHAT_ID="<your-chat-id>"

# Optional: initial admin password used ONLY when the database is created for the first time.
# If not set, a random password is generated and printed to the backend logs once.
# ADMIN_PASSWORD="<strong-password>"

# Optional: comma-separated list of allowed CORS origins (default: same-origin only via nginx proxy).
# CORS_ORIGINS="http://localhost:8080"

# Optional: Fernet key that encrypts Tapo passwords and 2FA secrets in the DB.
# If empty, a key is generated once into data/secret.key (keep a copy of it next to your DB backups!).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_KEY="<fernet-key>"

# Optional: contact for Web Push VAPID claims
# VAPID_SUBJECT="mailto:you@example.com"
